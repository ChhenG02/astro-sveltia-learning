---
import { getCollection, render } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.number.localeCompare(b.data.number),
);

const renderedServices = await Promise.all(
	services.map(async (service) => {
		const { Content } = await render(service);
		return { service, Content };
	}),
);
---

<MainLayout
	title={`Engineering Services | ${SITE_TITLE}`}
	description="Factory automation, industrial robotics, SAUTER building automation (BMS/EMS), and custom 5000A electrical power panels by PATech in Cambodia."
>
	<header class="page-header-v2 section-space-top">
		<div class="container">
			<div class="page-header-grid" data-reveal>
				<div>
					<span class="label-tag">Our Capabilities · 3 Core Divisions</span>
					<h1>Complete automation &amp; power solutions.</h1>
				</div>
				<div class="page-header-side">
					<p>
						One accountable team from site survey and electrical CAD drawings to in-house panel assembly, PLC/SCADA programming, and 24/7 after-sales support. Select any division below to see our step-by-step engineering flow and solutions.
					</p>
				</div>
			</div>
		</div>
	</header>

	<section class="section-space">
		<div class="container">
			<div class="services-staggered-row">
				{services.map((service, index) => (
					<ServiceCard service={service.data} index={index} />
				))}
			</div>
		</div>
	</section>

	<section class="section-space section-offwhite">
		<div class="container">
			<div class="services-deep-list">
				{renderedServices.map(({ service, Content }) => (
					<article class="service-detail-card" id={service.data.slug} data-reveal>
						<div class="service-detail-photo notched-photo-wrap">
							<img
								src={service.data.coverImage}
								alt={service.data.coverImageAlt}
								loading="lazy"
								width="640"
								height="440"
								class="notched-photo-img"
							/>
							<a
								href={`/services/${service.data.slug}/`}
								class="notch-cutout"
								aria-label={`View full details and flow for ${service.data.title}`}
							>
								<span class="notch-yellow-btn">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
										<line x1="7" y1="17" x2="17" y2="7"></line>
										<polyline points="7 7 17 7 17 17"></polyline>
									</svg>
								</span>
							</a>
						</div>

						<div class="service-detail-copy">
							<span class="label-tag">Division {service.data.number}</span>
							<h2>
								<a href={`/services/${service.data.slug}/`}>{service.data.title}</a>
							</h2>
							<div class="prose-v2">
								<Content />
							</div>

							{service.data.highlights && service.data.highlights.length > 0 && (
								<ul class="service-highlights-list">
									{service.data.highlights.map((item) => (
										<li>
											<span class="check-circle" aria-hidden="true">✓</span>
											<span>{item}</span>
										</li>
									))}
								</ul>
							)}

							<div class="service-detail-actions">
								<a class="btn-secondary" href={`/services/${service.data.slug}/`}>
									<span>Explore {service.data.shortTitle} Flow &amp; Solutions</span>
									<span class="btn-arrow-circle" aria-hidden="true">↗</span>
								</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</MainLayout>
