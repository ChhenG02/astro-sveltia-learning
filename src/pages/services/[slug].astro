---
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
	const services = await getCollection('services', ({ data }) => !data.draft);
	return services.map((service) => ({
		params: { slug: service.data.slug },
		props: { service },
	}));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const allServices = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.number.localeCompare(b.data.number),
);
const otherServices = allServices.filter((s) => s.data.slug !== data.slug);

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const relatedProjects = allProjects
	.filter((project) => project.data.services?.includes(data.slug))
	.sort((a, b) => (b.data.createdAt?.getTime() ?? 0) - (a.data.createdAt?.getTime() ?? 0));

// Group solutions by category for clear visual flow
const solutionCategories = new Map<string, typeof data.solutions>();
for (const sol of data.solutions || []) {
	const cat = sol.category || 'Core Solutions';
	const list = solutionCategories.get(cat) || [];
	list.push(sol);
	solutionCategories.set(cat, list);
}
---

<MainLayout
	title={`${data.title} | ${SITE_TITLE} Services`}
	description={data.summary}
	image={data.coverImage}
>
	<article class="detail-page-v2 section-space-top">
		<div class="container">
			<div class="detail-top-bar" data-reveal>
				<a class="back-pill-link" href="/services/">← All Engineering Services</a>
				<div class="detail-meta-pills">
					<span class="pill-tag pill-tag-dark">Division {data.number}</span>
					<span class="pill-tag pill-tag-cream">{data.shortTitle}</span>
				</div>
			</div>

			<header class="service-hero-split" data-reveal>
				<div class="service-hero-copy">
					<span class="label-tag">Service Division {data.number} · End-to-End Delivery</span>
					<h1>{data.title}</h1>
					<p class="detail-lead">{data.summary}</p>
					<div class="prose-v2 service-overview-prose">
						<Content />
					</div>

					<div class="service-quick-jumps">
						<a href="#delivery-flow" class="pill-filter-btn is-active">1. How Our Flow Works ↓</a>
						<a href="#solutions" class="pill-filter-btn">2. Solutions Catalog ({data.solutions.length}) ↓</a>
						{relatedProjects.length > 0 && (
							<a href="#related-projects" class="pill-filter-btn">3. Related Projects ({relatedProjects.length}) ↓</a>
						)}
					</div>
				</div>

				<div class="service-hero-media notched-photo-wrap">
					<img
						src={data.coverImage}
						alt={data.coverImageAlt}
						width="640"
						height="500"
						class="notched-photo-img"
					/>
					<a href="#solutions" class="notch-cutout" aria-label="Jump to solutions">
						<span class="notch-yellow-btn">↓</span>
					</a>
				</div>
			</header>

			<!-- WHY IT MATTERS (3 Key Benefits) -->
			{data.benefits && data.benefits.length > 0 && (
				<section class="service-benefits-section" aria-label="Why it matters" data-reveal>
					<div class="service-benefits-grid">
						{data.benefits.map((benefit, idx) => (
							<div class="service-benefit-card">
								<span class="benefit-num-badge">0{idx + 1}</span>
								<h3>{benefit.title}</h3>
								<p>{benefit.description}</p>
							</div>
						))}
					</div>
				</section>
			)}

			<!-- STEP-BY-STEP ENGINEERING DELIVERY FLOW -->
			{data.workflow && data.workflow.length > 0 && (
				<section class="service-flow-section section-space" id="delivery-flow" aria-label="Engineering delivery flow">
					<div class="section-header-split" data-reveal>
						<div>
							<span class="label-tag">Step-by-Step Workflow</span>
							<h2 class="section-title">How we deliver {data.shortTitle}, from site survey to handover</h2>
						</div>
					</div>

					<div class="workflow-steps-grid">
						{data.workflow.map((wf, idx) => (
							<article class="workflow-step-card" data-reveal>
								<div class="workflow-step-top">
									<span class="workflow-step-pill">Step {wf.step}</span>
									{idx < data.workflow.length - 1 && (
										<span class="workflow-connector-arrow" aria-hidden="true">→</span>
									)}
								</div>
								<h3>{wf.title}</h3>
								<p>{wf.description}</p>
							</article>
						))}
					</div>
				</section>
			)}

			<!-- DETAILED SOLUTIONS CATALOG (Grouped by Category) -->
			{data.solutions && data.solutions.length > 0 && (
				<section class="service-solutions-section section-space-bottom" id="solutions" aria-label="Solutions catalog">
					<div class="section-header-split" data-reveal>
						<div>
							<span class="label-tag">Solutions &amp; Capabilities</span>
							<h2 class="section-title">What we build inside {data.shortTitle}</h2>
						</div>
					</div>

					{Array.from(solutionCategories.entries()).map(([categoryName, items]) => (
						<div class="solution-category-group">
							<h3 class="solution-category-heading" data-reveal>{categoryName}</h3>

							<div class="solutions-cards-stack">
								{items.map((sol) => (
									<article class="solution-flow-card" data-reveal>
										{sol.image && (
											<div class="solution-flow-photo notched-photo-wrap">
												<img
													src={sol.image}
													alt={sol.title}
													loading="lazy"
													width="520"
													height="360"
													class="notched-photo-img"
												/>
											</div>
										)}

										<div class="solution-flow-body">
											<h4>{sol.title}</h4>
											<p class="solution-flow-summary">{sol.summary}</p>

											<div class="solution-flow-breakdown">
												{sol.problem && (
													<div class="flow-meta-box is-problem">
														<span class="flow-meta-label">Problem Solved</span>
														<p>{sol.problem}</p>
													</div>
												)}
												{sol.applications && (
													<div class="flow-meta-box is-app">
														<span class="flow-meta-label">Typical Applications</span>
														<p>{sol.applications}</p>
													</div>
												)}
												{sol.benefits && (
													<div class="flow-meta-box is-benefit">
														<span class="flow-meta-label">Key Benefits &amp; Result</span>
														<p>{sol.benefits}</p>
													</div>
												)}
											</div>
										</div>
									</article>
								))}
							</div>
						</div>
					))}
				</section>
			)}
		</div>
	</article>

	<!-- RELATED PROJECTS FOR THIS SERVICE -->
	{relatedProjects.length > 0 && (
		<section class="section-space section-offwhite" id="related-projects" aria-label="Related projects">
			<div class="container">
				<div class="section-header-split" data-reveal>
					<div>
						<span class="label-tag">Proven in the Field</span>
						<h2 class="section-title">Commissioned {data.shortTitle} projects</h2>
					</div>
					<a class="btn-secondary" href="/projects/">
						<span>View All Projects</span>
						<span class="btn-arrow-circle" aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="projects-staggered-grid">
					{relatedProjects.map((project, idx) => (
						<ProjectCard project={project} staggerIndex={idx} />
					))}
				</div>
			</div>
		</section>
	)}

	<!-- EXPLORE OTHER SERVICE DIVISIONS -->
	{otherServices.length > 0 && (
		<section class="section-space" aria-label="Other service divisions">
			<div class="container">
				<div class="section-header-split" data-reveal>
					<div>
						<span class="label-tag">Other PATech Divisions</span>
						<h2 class="section-title">Explore other engineering services</h2>
					</div>
					<a class="back-pill-link" href="/services/">← Back to Services Overview</a>
				</div>

				<div class="other-services-grid">
					{otherServices.map((other) => (
						<a href={`/services/${other.data.slug}/`} class="other-service-card" data-reveal>
							<div class="other-service-photo notched-photo-wrap">
								<img
									src={other.data.coverImage}
									alt={other.data.coverImageAlt}
									loading="lazy"
									width="560"
									height="320"
									class="notched-photo-img"
								/>
								<span class="notch-cutout" aria-hidden="true">
									<span class="notch-yellow-btn">↗</span>
								</span>
							</div>
							<div class="other-service-body">
								<span class="label-tag">Division {other.data.number}</span>
								<h3>{other.data.title}</h3>
								<p>{other.data.summary}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}
</MainLayout>
