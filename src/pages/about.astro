---
import { SITE_TITLE, TEAM_AVATARS, WHY_CHOOSE_US } from '../consts';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
	title={`About PATech | ${SITE_TITLE}`}
	description="Pisnuk AutoTech Co., Ltd. (PATech) is a Cambodian automation and electrical engineering company founded in 2018 with 40+ engineers and technicians."
>
	<header class="page-header-v2 section-space-top">
		<div class="container">
			<div class="page-header-grid" data-reveal>
				<div>
					<span class="label-tag">About Pisnuk AutoTech · Registered Aug 2018</span>
					<h1>Engineers first.<br />Salespeople never.</h1>
				</div>
				<div class="page-header-side">
					<p>
						PATech started in early 2018 as a hands-on engineering crew modifying machine controllers, programming PLCs, and maintaining electrical switchboards. Today, 40+ staff across 5 departments design, build, and support critical systems across Cambodia.
					</p>
				</div>
			</div>
		</div>
	</header>

	<section class="section-space">
		<div class="container">
			<div class="about-collage-grid">
				<div class="about-photo-large notched-photo-wrap" data-reveal>
					<img
						src="/images/about/about-team.jpg"
						alt="PATech engineering team in Phnom Penh"
						width="640"
						height="440"
						class="notched-photo-img"
					/>
					<a href="/contact/" class="notch-cutout" aria-label="Work with our team">
						<span class="notch-yellow-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
								<line x1="7" y1="17" x2="17" y2="7"></line>
								<polyline points="7 7 17 7 17 17"></polyline>
							</svg>
						</span>
					</a>
				</div>

				<div class="about-stats-pair" data-reveal>
					<div class="big-stat-block">
						<strong class="big-stat-value">40+</strong>
						<span class="big-stat-label">Engineers &amp; assembly technicians in 5 departments</span>
					</div>
					<div class="big-stat-divider" aria-hidden="true"></div>
					<div class="big-stat-block">
						<strong class="big-stat-value">1k+</strong>
						<span class="big-stat-label">Automation &amp; electrical projects delivered since 2018</span>
					</div>
				</div>

				<div class="about-photo-small" data-reveal>
					<img
						src="/images/about/about-story-02.jpg"
						alt="PATech annual team meeting"
						loading="lazy"
						width="360"
						height="280"
					/>
					<span class="small-photo-caption">Phnom Penh Nano Factory &amp; Service Hub</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section-space section-offwhite">
		<div class="container">
			<div class="section-header-split" data-reveal>
				<div>
					<span class="label-tag">Authorized Partnerships</span>
					<h2 class="section-title">Certified international &amp; local partners</h2>
				</div>
			</div>

			<div class="partner-certs-grid">
				<article class="cert-card" data-reveal>
					<div class="cert-copy">
						<span class="pill-tag pill-tag-dark">Authorized Since 2022</span>
						<h3>Authorized SAUTER System Agent for Cambodia</h3>
						<p>
							SAUTER (Basel, Switzerland, est. 1910) recognizes PATech as an authorized system agent in Cambodia for SAUTER building automation controls, BMS, EMS, and IBMS installations.
						</p>
					</div>
					<img
						src="/images/about/about-certificate-01.png"
						alt="SAUTER System Agent Authorization Certificate for PATech"
						loading="lazy"
						width="260"
						height="340"
						class="cert-img"
					/>
				</article>

				<article class="cert-card" data-reveal>
					<div class="cert-copy">
						<span class="pill-tag pill-tag-dark">Official Low-Voltage Partner</span>
						<h3>Official CHINT Partner with SchneiTec Trading</h3>
						<p>
							An official partnership between PATech, SchneiTec Trading Co., Ltd., and CHINT for low-voltage switchgear and power distribution equipment across Cambodia.
						</p>
					</div>
					<img
						src="/images/about/about-certificate-02.png"
						alt="Official CHINT and SchneiTec Partnership Certificate"
						loading="lazy"
						width="320"
						height="240"
						class="cert-img"
					/>
				</article>
			</div>
		</div>
	</section>

	<section class="section-space">
		<div class="container">
			<div class="section-header-split" data-reveal>
				<div>
					<span class="label-tag">Engineering Leadership</span>
					<h2 class="section-title">Meet the engineers leading every job</h2>
				</div>
			</div>

			<div class="leadership-grid">
				{TEAM_AVATARS.map((member) => (
					<article class="leader-card" data-reveal>
						<img src={member.src} alt={member.name} width="240" height="240" loading="lazy" />
						<h3>{member.name}</h3>
						<span>{member.role}</span>
					</article>
				))}
			</div>
		</div>
	</section>
</MainLayout>
