---
import { CULTURE_PHOTOS, SITE_TITLE } from '../consts';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
	title={`About PATech | ${SITE_TITLE}`}
	description="Pisnuk AutoTech Co., Ltd. (PATech) is a Cambodian automation and electrical engineering company founded in 2018 with 40+ engineers and technicians."
>
	<header class="page-header-v2 section-space-top">
		<div class="container">
			<div class="page-header-grid" data-reveal>
				<div>
					<span class="label-tag">About Pisnuk AutoTech · Registered Aug 2018</span>
					<h1>Engineers building a smarter, more autonomous society</h1>
				</div>
				<div class="page-header-side">
					<p>
						PATech started in early 2018 as a technical team modifying machine controllers, programming PLCs, customising factory automation and maintaining electrical panels in factories and commercial buildings. On 23 August 2018 we were officially registered with the Ministry of Commerce as Pisnuk AutoTech Co., Ltd.
					</p>
				</div>
			</div>
		</div>
	</header>

	<section class="section-space">
		<div class="container">
			<div class="about-collage-grid">
				<div class="about-photo-large notched-photo-wrap" data-reveal>
					<img
						src="/images/about/about-team.jpg"
						alt="PATech engineering team in Phnom Penh"
						width="640"
						height="440"
						class="notched-photo-img"
					/>
				</div>

				<div class="about-stats-pair" data-reveal>
					<div class="big-stat-block">
						<strong class="big-stat-value">40+</strong>
						<span class="big-stat-label">Engineers &amp; assembly technicians in 5 departments</span>
					</div>
					<div class="big-stat-divider" aria-hidden="true"></div>
					<div class="big-stat-block">
						<strong class="big-stat-value">1k+</strong>
						<span class="big-stat-label">Automation &amp; electrical projects delivered since 2018</span>
					</div>
				</div>

				<div class="about-photo-small" data-reveal>
					<img
						src="/images/about/about-story-02.jpg"
						alt="PATech annual team meeting"
						loading="lazy"
						width="360"
						height="280"
					/>
					<span class="small-photo-caption">Phnom Penh Nano Factory &amp; Service Hub</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section-space section-offwhite">
		<div class="container">
			<div class="section-header-split" data-reveal>
				<div>
					<span class="label-tag">Authorized Partnerships</span>
					<h2 class="section-title">Certified international &amp; local partners</h2>
				</div>
			</div>

			<div class="partner-certs-grid">
				<article class="cert-card" data-reveal>
					<div class="cert-copy">
						<span class="pill-tag pill-tag-dark">Authorized Since 2022</span>
						<h3>Authorized SAUTER System Agent for Cambodia</h3>
						<p>
							SAUTER (Basel, Switzerland, est. 1910) recognizes PATech as an authorized system agent in Cambodia for SAUTER building automation controls, BMS, EMS, and IBMS installations.
						</p>
					</div>
					<img
						src="/images/about/about-certificate-01.png"
						alt="SAUTER System Agent Authorization Certificate for PATech"
						loading="lazy"
						width="260"
						height="340"
						class="cert-img"
					/>
				</article>

				<article class="cert-card" data-reveal>
					<div class="cert-copy">
						<span class="pill-tag pill-tag-dark">Official Low-Voltage Partner</span>
						<h3>Official CHINT Partner with SchneiTec Trading</h3>
						<p>
							An official partnership between PATech, SchneiTec Trading Co., Ltd., and CHINT for low-voltage switchgear and power distribution equipment across Cambodia.
						</p>
					</div>
					<img
						src="/images/about/about-certificate-02.png"
						alt="Official CHINT and SchneiTec Partnership Certificate"
						loading="lazy"
						width="320"
						height="240"
						class="cert-img"
					/>
				</article>
			</div>
		</div>
	</section>

	<section class="section-space">
		<div class="container">
			<div class="section-header-split" data-reveal>
				<div>
					<span class="label-tag">Our Leadership</span>
					<h2 class="section-title">Founder &amp; CEO</h2>
					<p class="leadership-subtitle">Meet the leadership behind PATech.</p>
				</div>
			</div>

			<div class="ceo-spotlight-card" data-reveal>
				<div class="ceo-photo-frame">
					<img
						src="/images/team/ceo.jpg"
						alt="Portrait of Sokun Nhoem"
						width="360"
						height="450"
						loading="lazy"
					/>
				</div>
				<div class="ceo-copy-col">
					<span class="ceo-kicker">Leadership</span>
					<blockquote class="ceo-quote">
						“Since 2018 our goal has been simple: understand our customers' problems and solve them with safe, reliable automation. Thank you for trusting PATech.”
					</blockquote>
					<div class="ceo-meta">
						<strong>Sokun Nhoem</strong>
						<span>Founder &amp; Chief Executive Officer</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section-space section-offwhite" aria-label="People, culture & community">
		<div class="container">
			<div class="section-header-split" data-reveal>
				<div>
					<span class="label-tag">Inside PATech</span>
					<h2 class="section-title">People, culture &amp; community</h2>
					<p class="leadership-subtitle">
						Team trips, celebrations and giving back — the moments that make PATech a team.
					</p>
				</div>
			</div>

			<ul class="culture-gallery-grid" data-reveal>
				{CULTURE_PHOTOS.map((photo, index) => (
					<li
						class={`culture-tile ${index === 0 ? 'is-featured' : ''} ${
							index >= CULTURE_PHOTOS.length - 2 ? 'is-wide' : ''
						}`.trim()}
					>
						<button
							type="button"
							class="culture-tile-btn"
							data-culture-index={index}
							data-culture-src={photo.src}
							data-culture-alt={photo.alt}
							aria-label={`View larger: ${photo.alt}`}
						>
							<img src={photo.src} alt={photo.alt} loading="lazy" />
							<span class="culture-tile-overlay" aria-hidden="true"></span>
							<span class="culture-expand-badge" aria-hidden="true">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="15 3 21 3 21 9"></polyline>
									<polyline points="9 21 3 21 3 15"></polyline>
									<line x1="21" y1="3" x2="14" y2="10"></line>
									<line x1="3" y1="21" x2="10" y2="14"></line>
								</svg>
							</span>
						</button>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div
		class="culture-lightbox"
		id="culture-lightbox"
		role="dialog"
		aria-modal="true"
		aria-label="Photo viewer"
		hidden
	>
		<button type="button" class="culture-lb-btn culture-lb-close" id="culture-lb-close" aria-label="Close">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
		<button type="button" class="culture-lb-btn culture-lb-prev" id="culture-lb-prev" aria-label="Previous">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
		</button>
		<figure class="culture-lb-figure">
			<img id="culture-lb-img" src="" alt="" />
			<figcaption id="culture-lb-caption" class="culture-lb-caption"></figcaption>
		</figure>
		<button type="button" class="culture-lb-btn culture-lb-next" id="culture-lb-next" aria-label="Next">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="9 18 15 12 9 6"></polyline>
			</svg>
		</button>
	</div>
</MainLayout>

<script>
	const tileButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-culture-index]'),
	);
	const lightbox = document.getElementById('culture-lightbox');
	const lbImg = document.getElementById('culture-lb-img') as HTMLImageElement | null;
	const lbCaption = document.getElementById('culture-lb-caption');
	const closeBtn = document.getElementById('culture-lb-close');
	const prevBtn = document.getElementById('culture-lb-prev');
	const nextBtn = document.getElementById('culture-lb-next');

	if (tileButtons.length > 0 && lightbox && lbImg && lbCaption && closeBtn && prevBtn && nextBtn) {
		const photos = tileButtons.map((btn) => ({
			src: btn.dataset.cultureSrc || '',
			alt: btn.dataset.cultureAlt || '',
		}));
		let currentIndex = 0;

		const renderPhoto = (index: number) => {
			currentIndex = (index + photos.length) % photos.length;
			const item = photos[currentIndex];
			lbImg.src = item.src;
			lbImg.alt = item.alt;
			lbCaption.textContent = `${item.alt} · ${currentIndex + 1} / ${photos.length}`;
		};

		const openLightbox = (index: number) => {
			renderPhoto(index);
			lightbox.hidden = false;
			document.body.style.overflow = 'hidden';
			closeBtn.focus();
		};

		const closeLightbox = () => {
			lightbox.hidden = true;
			document.body.style.overflow = '';
		};

		tileButtons.forEach((btn, idx) => {
			btn.addEventListener('click', () => openLightbox(idx));
		});

		closeBtn.addEventListener('click', closeLightbox);
		prevBtn.addEventListener('click', () => renderPhoto(currentIndex - 1));
		nextBtn.addEventListener('click', () => renderPhoto(currentIndex + 1));

		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) {
				closeLightbox();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (lightbox.hidden) return;
			if (event.key === 'Escape') {
				closeLightbox();
			} else if (event.key === 'ArrowLeft') {
				renderPhoto(currentIndex - 1);
			} else if (event.key === 'ArrowRight') {
				renderPhoto(currentIndex + 1);
			}
		});
	}
</script>
