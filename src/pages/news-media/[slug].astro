---
import { getCollection, render } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import { SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';
import { resolveNewsThumbnail } from '../../utils/news';

export async function getStaticPaths() {
	const items = await getCollection('news', ({ data }) => !data.draft);
	return items.map((item) => ({
		params: { slug: item.data.slug || item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { data } = item;
const currentSlug = data.slug || item.id;
const { Content } = await render(item);
const thumbnailSrc = resolveNewsThumbnail(data);

const isVideo = data.contentType === 'Video' || Boolean(data.embedUrl);
const formattedDate = data.publishedDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const allNews = await getCollection('news', ({ data }) => !data.draft);
const relatedNews = allNews
	.filter((entry) => (entry.data.slug || entry.id) !== currentSlug)
	.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
	.slice(0, 3);
---

<MainLayout
	title={`${data.title} | ${SITE_TITLE} News & Media`}
	description={data.summary}
	image={thumbnailSrc}
>
	<article class="detail-page-v2 section-space-top">
		<div class="container">
			<div class="article-narrow-col">
				<div class="detail-top-bar" data-reveal>
					<a class="back-pill-link" href="/news-media/">← Back to News &amp; Media</a>
					<div class="detail-meta-pills">
						<span class="pill-tag pill-tag-dark">{data.contentType}</span>
						<span class="pill-tag pill-tag-cream">{data.source} · {formattedDate}</span>
					</div>
				</div>

				<header class="detail-header-v2" data-reveal>
					<h1>{data.title}</h1>
					<p class="detail-lead">{data.summary}</p>
				</header>

				{isVideo && data.embedUrl ? (
					<div class="video-embed-frame" data-reveal>
						<iframe
							src={data.embedUrl}
							title={`Watch: ${data.title}`}
							allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
							allowfullscreen
						></iframe>
					</div>
				) : (
					<div class="detail-hero-photo notched-photo-wrap" data-reveal>
						<img
							src={thumbnailSrc}
							alt={data.featuredImageAlt || data.title}
							width="960"
							height="540"
							class="notched-photo-img"
						/>
						{data.externalUrl && (
							<a
								href={data.externalUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="notch-cutout"
								aria-label={
									data.externalUrl.includes('youtube.com') ||
									data.externalUrl.includes('youtu.be') ||
									data.source === 'YouTube'
										? 'Watch on YouTube'
										: data.externalUrl.includes('facebook.com') ||
											  data.externalUrl.includes('fb.watch') ||
											  data.source === 'Facebook'
											? 'Watch on Facebook'
											: 'Open external link'
								}
							>
								<span class="notch-yellow-btn">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
										<line x1="7" y1="17" x2="17" y2="7"></line>
										<polyline points="7 7 17 7 17 17"></polyline>
									</svg>
								</span>
							</a>
						)}
					</div>
				)}

				<div class="prose-v2 article-prose-body" data-reveal>
					<Content />
				</div>

				{data.externalUrl && (
					<div class="external-watch-box" data-reveal>
						<a
							href={data.externalUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-secondary"
						>
							<span>
								{data.externalUrl.includes('youtube.com') ||
								data.externalUrl.includes('youtu.be') ||
								data.source === 'YouTube'
									? 'Watch on YouTube'
									: data.externalUrl.includes('facebook.com') ||
										  data.externalUrl.includes('fb.watch') ||
										  data.source === 'Facebook'
										? 'Watch on Facebook'
										: data.externalUrl.includes('x.com') || data.externalUrl.includes('twitter.com')
											? 'Watch on X'
											: data.source && data.source !== 'PATech'
												? `Watch on ${data.source}`
												: 'Watch Video'}
							</span>
							<span class="btn-arrow-circle" aria-hidden="true">↗</span>
						</a>
					</div>
				)}

				{data.topics && data.topics.length > 0 && (
					<footer class="article-topics-footer" data-reveal>
						<span class="topics-label">Topics:</span>
						{data.topics.map((topic) => (
							<span class="news-topic-pill">{topic}</span>
						))}
					</footer>
				)}
			</div>
		</div>
	</article>

	{relatedNews.length > 0 && (
		<section class="section-space section-offwhite">
			<div class="container">
				<div class="section-header-split" data-reveal>
					<div>
						<span class="label-tag">More from PATech</span>
						<h2 class="section-title">Latest articles &amp; videos</h2>
					</div>
					<a class="btn-secondary" href="/news-media/">
						<span>All News &amp; Media</span>
						<span class="btn-arrow-circle" aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="news-grid-three">
					{relatedNews.map((rel) => (
						<NewsCard item={rel} />
					))}
				</div>
			</div>
		</section>
	)}

	<div
		class="culture-lightbox"
		id="article-lightbox"
		role="dialog"
		aria-modal="true"
		aria-label="Image viewer"
		hidden
	>
		<button type="button" class="culture-lb-btn culture-lb-close" id="article-lb-close" aria-label="Close">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
		<button type="button" class="culture-lb-btn culture-lb-prev" id="article-lb-prev" aria-label="Previous">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
		</button>
		<figure class="culture-lb-figure">
			<img id="article-lb-img" src="" alt="" />
			<figcaption id="article-lb-caption" class="culture-lb-caption"></figcaption>
		</figure>
		<button type="button" class="culture-lb-btn culture-lb-next" id="article-lb-next" aria-label="Next">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="9 18 15 12 9 6"></polyline>
			</svg>
		</button>
	</div>
</MainLayout>

<script>
	const articleImages = Array.from(
		document.querySelectorAll<HTMLImageElement>('.detail-hero-photo img, .article-prose-body img'),
	);
	const lightbox = document.getElementById('article-lightbox');
	const lbImg = document.getElementById('article-lb-img') as HTMLImageElement | null;
	const lbCaption = document.getElementById('article-lb-caption');
	const closeBtn = document.getElementById('article-lb-close');
	const prevBtn = document.getElementById('article-lb-prev');
	const nextBtn = document.getElementById('article-lb-next');

	if (articleImages.length > 0 && lightbox && lbImg && lbCaption && closeBtn && prevBtn && nextBtn) {
		const photos = articleImages.map((img) => ({
			src: img.currentSrc || img.src,
			alt: img.alt || '',
		}));
		let currentIndex = 0;

		if (photos.length <= 1) {
			prevBtn.hidden = true;
			nextBtn.hidden = true;
			prevBtn.style.display = 'none';
			nextBtn.style.display = 'none';
		}

		const renderPhoto = (index: number) => {
			currentIndex = (index + photos.length) % photos.length;
			const photo = photos[currentIndex];
			lbImg.src = photo.src;
			lbImg.alt = photo.alt;
			lbCaption.textContent =
				photos.length > 1
					? `${photo.alt} · ${currentIndex + 1} / ${photos.length}`
					: photo.alt;
		};

		const openLightbox = (index: number) => {
			renderPhoto(index);
			lightbox.hidden = false;
			document.body.style.overflow = 'hidden';
			closeBtn.focus();
		};

		const closeLightbox = () => {
			lightbox.hidden = true;
			document.body.style.overflow = '';
		};

		articleImages.forEach((img, idx) => {
			img.style.cursor = 'zoom-in';
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', img.alt ? `View image: ${img.alt}` : 'View image');
			img.addEventListener('click', () => openLightbox(idx));
			img.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					openLightbox(idx);
				}
			});
		});

		closeBtn.addEventListener('click', closeLightbox);
		prevBtn.addEventListener('click', () => renderPhoto(currentIndex - 1));
		nextBtn.addEventListener('click', () => renderPhoto(currentIndex + 1));

		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) {
				closeLightbox();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (lightbox.hidden) return;
			if (event.key === 'Escape') {
				closeLightbox();
			} else if (event.key === 'ArrowLeft' && photos.length > 1) {
				renderPhoto(currentIndex - 1);
			} else if (event.key === 'ArrowRight' && photos.length > 1) {
				renderPhoto(currentIndex + 1);
			}
		});
	}
</script>
