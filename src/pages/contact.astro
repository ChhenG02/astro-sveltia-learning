---
import { CONTACT_INFO, FAQS, SITE_TITLE } from '../consts';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
	title={`Contact & Get a Quote | ${SITE_TITLE}`}
	description="Request a free on-site survey or quotation from PATech in Phnom Penh for factory automation, SAUTER BMS, or custom electrical panels."
>
	<header class="page-header-v2 section-space-top">
		<div class="container">
			<div class="page-header-grid" data-reveal>
				<div>
					<span class="label-tag">Contact &amp; Free Site Survey</span>
					<h1>Talk directly with our engineering team.</h1>
				</div>
				<div class="page-header-side">
					<p>
						No call centers or sales scripts. Share your site location, drawings, or breakdown issue and an engineer will reply within one business day (or immediately for 24/7 emergencies).
					</p>
				</div>
			</div>
		</div>
	</header>

	<section class="section-space">
		<div class="container contact-grid-v2">
			<div class="contact-form-card" data-reveal>
				<h2>Request a custom quote</h2>
				<p class="form-sub">Site surveys and quotations are free across Phnom Penh and provinces.</p>

				<form class="quote-form-v2" id="quote-request-form" action="#" method="post" novalidate>
					<div class="form-row-two">
						<label>
							<span>Full name *</span>
							<input type="text" name="name" required placeholder="Your name" />
						</label>
						<label>
							<span>Phone / Telegram *</span>
							<input type="tel" name="phone" required placeholder="+855 ..." />
						</label>
					</div>

					<div class="form-row-two">
						<label>
							<span>Company / Facility</span>
							<input type="text" name="company" placeholder="Factory or building name" />
						</label>
						<label>
							<span>Service needed</span>
							<select name="service">
								<option value="Factory Automation">Factory Automation (PLC / SCADA / Robotics)</option>
								<option value="Building Automation">Building Automation (SAUTER BMS / EMS)</option>
								<option value="Electrical Power Panels">Electrical Power Panels (MSB / MDB / ATS / MCC)</option>
								<option value="24/7 Emergency Support">24/7 Emergency Troubleshooting</option>
							</select>
						</label>
					</div>

					<label>
						<span>Project details *</span>
						<textarea
							name="message"
							rows="4"
							required
							placeholder="Tell us about your machine, switchboard rating, site location, and timeline..."
						></textarea>
					</label>

					<button
						type="submit"
						class="quote-submit-btn"
						id="quote-submit-btn"
						data-state="default"
						aria-live="polite"
					>
						<span class="quote-submit-content">
							<!-- Loading spinner (shown in loading state) -->
							<svg
								class="quote-btn-icon quote-spinner-icon"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.25"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<path d="M21 12a9 9 0 1 1-6.219-8.56" />
							</svg>

							<!-- Check icon (shown in success state) -->
							<svg
								class="quote-btn-icon quote-check-icon"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.4"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<polyline points="20 6 9 17 4 12" />
							</svg>

							<span class="quote-submit-label" id="quote-submit-label">
								Send Request to Engineers
							</span>
						</span>

						<!-- Integrated northeast arrow on the right (shown in default/error state) -->
						<svg
							class="quote-arrow-icon"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<line x1="7" y1="17" x2="17" y2="7" />
							<polyline points="8 7 17 7 17 16" />
						</svg>
					</button>

					<p class="form-success-msg" id="quote-success-msg" role="status" aria-live="polite">
						✓ Thank you! Your request has been sent to our engineering team. For immediate assistance, call <a href={CONTACT_INFO.phoneHref}>{CONTACT_INFO.phone}</a> or message <a href={CONTACT_INFO.telegramHref}>{CONTACT_INFO.telegram}</a>.
					</p>

					<p class="form-error-msg" id="quote-error-msg" role="alert" hidden>
						Unable to send your request. Please check the required fields and try again, or call <a href={CONTACT_INFO.phoneHref}>{CONTACT_INFO.phone}</a>.
					</p>
				</form>
			</div>

			<aside class="contact-info-stack" data-reveal>
				<div class="contact-cream-card">
					<span class="label-tag">24/7 Engineering Hotline</span>
					<h3><a href={CONTACT_INFO.phoneHref}>{CONTACT_INFO.phone}</a></h3>
					<p>Secondary line: <a href={CONTACT_INFO.phoneAltHref}>{CONTACT_INFO.phoneAlt}</a></p>
					<p>Email: <a href={`mailto:${CONTACT_INFO.email}`}>{CONTACT_INFO.email}</a></p>
					<p>Telegram: <a href={CONTACT_INFO.telegramHref} target="_blank" rel="noopener noreferrer">{CONTACT_INFO.telegram}</a></p>
				</div>

				<div class="contact-cream-card">
					<span class="label-tag">PATech Nano Factory · Phnom Penh</span>
					<p><strong>{CONTACT_INFO.address}</strong></p>
					<p class="contact-directions">{CONTACT_INFO.directions}</p>
					<p class="contact-hours">{CONTACT_INFO.hours}</p>
				</div>

				<a
					href={CONTACT_INFO.mapUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="contact-map-card notched-photo-wrap"
				>
					<img
						src="/images/contact/map-directions.png"
						alt="Map directions to PATech Nano Factory near AEON Mall Sen Sok"
						loading="lazy"
						width="550"
						height="360"
						class="notched-photo-img"
					/>
					<span class="notch-cutout" aria-hidden="true">
						<span class="notch-yellow-btn">↗</span>
					</span>
				</a>
			</aside>
		</div>
	</section>
</MainLayout>

<script>
	const form = document.getElementById('quote-request-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('quote-submit-btn') as HTMLButtonElement | null;
	const submitLabel = document.getElementById('quote-submit-label');
	const errorMsg = document.getElementById('quote-error-msg');

	function setButtonState(state: 'default' | 'loading' | 'success' | 'error') {
		if (!submitBtn || !submitLabel) return;
		submitBtn.dataset.state = state;

		if (state === 'loading') {
			submitBtn.disabled = true;
			submitBtn.setAttribute('aria-busy', 'true');
			submitLabel.textContent = 'Sending Request...';
		} else if (state === 'success') {
			submitBtn.disabled = true;
			submitBtn.removeAttribute('aria-busy');
			submitLabel.textContent = 'Request Sent Successfully';
		} else if (state === 'error') {
			submitBtn.disabled = false;
			submitBtn.removeAttribute('aria-busy');
			submitLabel.textContent = 'Send Request to Engineers';
		} else {
			submitBtn.disabled = false;
			submitBtn.removeAttribute('aria-busy');
			submitLabel.textContent = 'Send Request to Engineers';
		}
	}

	if (form && submitBtn) {
		// Reset error/success state if user edits fields after a submission
		form.addEventListener('input', () => {
			if (errorMsg && !errorMsg.hidden) {
				errorMsg.hidden = true;
			}
			if (submitBtn.dataset.state === 'error') {
				setButtonState('default');
			}
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submitBtn.dataset.state === 'loading') return;

			if (!form.checkValidity()) {
				form.reportValidity();
				setButtonState('error');
				if (errorMsg) {
					errorMsg.textContent = 'Please complete all required fields (*) before sending your request.';
					errorMsg.hidden = false;
				}
				return;
			}

			if (errorMsg) errorMsg.hidden = true;
			form.classList.remove('is-sent');
			setButtonState('loading');

			try {
				await new Promise((resolve) => setTimeout(resolve, 700));
				form.classList.add('is-sent');
				setButtonState('success');
			} catch {
				setButtonState('error');
				if (errorMsg) {
					errorMsg.textContent =
						'Unable to send your request right now. Please try again or call our 24/7 engineering hotline.';
					errorMsg.hidden = false;
				}
			}
		});
	}
</script>
