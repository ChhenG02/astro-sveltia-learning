---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import MainLayout from '../layouts/MainLayout.astro';

const featuredProjects = (await getCollection(
	'projects',
	({ data }) => !data.draft && data.featured,
)).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const featuredServices = (await getCollection(
	'services',
	({ data }) => !data.draft && data.featured,
)).sort((a, b) => a.data.number.localeCompare(b.data.number));
---

<MainLayout
	title={`${SITE_TITLE} | Practical engineering for a changing world`}
	description={SITE_DESCRIPTION}
>
	<Hero
		eyebrow="Engineering that moves you forward"
		title="Better systems. Built for the real world."
		description="We bring engineering, automation, and technology together to make complex operations safer, smarter, and more reliable."
		image="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=1800&q=85"
		imageAlt="Engineers collaborating on an industrial project"
		primaryLabel="Explore our services"
		primaryHref="/services/"
		secondaryLabel="Talk with our team"
		secondaryHref="/contact/"
	/>

	<section class="intro-section section-space">
		<div class="container intro-grid">
			<p class="eyebrow">Built around your operation</p>
			<div>
				<h2>Engineering expertise, grounded in how work actually gets done.</h2>
				<p class="lead">
					From a single control system to a facility-wide modernization, we help teams make
					confident decisions and turn them into practical results.
				</p>
				<a class="text-link" href="/about/">Get to know Northline <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="section-space section-muted">
		<div class="container">
			<SectionHeading
				eyebrow="What we do"
				title="Connected expertise for critical work."
				description="A focused set of engineering services, shaped around the challenges that matter most to your team."
			/>
			<div class="service-grid">
				{featuredServices.map((service) => <ServiceCard service={service.data} />)}
			</div>
			<div class="section-link-row">
				<a class="text-link" href="/services/">View all services <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="section-space">
		<div class="container">
			<SectionHeading
				eyebrow="Selected work"
				title="Solutions made to last."
				description="A look at the kinds of complex environments where good engineering makes a measurable difference."
			/>
			<div class="project-grid">
				{featuredProjects.map((project) => <ProjectCard project={project} />)}
			</div>
			<div class="section-link-row">
				<a class="text-link" href="/projects/">Explore our projects <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="why-section section-space">
		<div class="container why-grid">
			<div class="why-image">
				<img
					src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=1200&q=85"
					alt="Technician reviewing equipment in an industrial facility"
					loading="lazy"
					width="1200"
					height="900"
				/>
			</div>
			<div class="why-content">
				<p class="eyebrow">Why Northline</p>
				<h2>Thoughtful engineering. Accountable delivery.</h2>
				<p>
					We pair deep technical knowledge with a clear view of your goals, constraints, and people.
					That means fewer handoffs, practical recommendations, and a team that stays with the work.
				</p>
				<ul class="check-list">
					<li>Independent advice tied to your operating goals</li>
					<li>Integrated teams from early design through commissioning</li>
					<li>Safety, maintainability, and lifecycle value considered from day one</li>
				</ul>
				<a class="button button-outline" href="/about/">How we work</a>
			</div>
		</div>
	</section>

	<PartnerLogos />
	<ContactCTA />
</MainLayout>
