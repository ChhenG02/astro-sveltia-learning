---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder,
);
const categories = [...new Set(projects.map((p) => p.data.category))];
---

<MainLayout
	title={`Projects Portfolio | ${SITE_TITLE}`}
	description="Explore PATech's robotics, factory automation, water SCADA, SAUTER BMS, and 5000A electrical power projects across Cambodia."
>
	<header class="page-header-v2 section-space-top">
		<div class="container">
			<div class="page-header-grid" data-reveal>
				<div>
					<span class="label-tag">Projects Portfolio · 1,000+ Delivered</span>
					<h1>Real engineering work on real sites.</h1>
				</div>
				<div class="page-header-side">
					<p>
						Browse our commissioned systems across steel fabrication, municipal water treatment, cement manufacturing, commercial buildings, and industrial solar.
					</p>
				</div>
			</div>

			<!-- Category Filter Pills -->
			<div class="filter-bar-v2" role="group" aria-label="Filter projects by category" data-reveal>
				<button
					type="button"
					class="pill-filter-btn is-active"
					data-project-filter="all"
					aria-pressed="true"
				>
					All Projects ({projects.length})
				</button>
				{categories.map((category) => (
					<button
						type="button"
						class="pill-filter-btn"
						data-project-filter={category}
						aria-pressed="false"
					>
						{category}
					</button>
				))}
			</div>
		</div>
	</header>

	<section class="section-space">
		<div class="container">
			<div class="projects-staggered-grid">
				{projects.map((project, index) => (
					<div data-project-item data-category={project.data.category}>
						<ProjectCard project={project} staggerIndex={index} />
					</div>
				))}
			</div>
			<p class="filter-status" id="project-filter-status" aria-live="polite"></p>
		</div>
	</section>
</MainLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
	const items = document.querySelectorAll<HTMLElement>('[data-project-item]');
	const status = document.getElementById('project-filter-status');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const selected = button.dataset.projectFilter;
			let count = 0;

			buttons.forEach((btn) => {
				const active = btn === button;
				btn.classList.toggle('is-active', active);
				btn.setAttribute('aria-pressed', String(active));
			});

			items.forEach((item) => {
				const show = selected === 'all' || item.dataset.category === selected;
				item.hidden = !show;
				if (show) count++;
			});

			if (status) {
				status.textContent = `Showing ${count} project${count === 1 ? '' : 's'}`;
			}
		});
	});
</script>
