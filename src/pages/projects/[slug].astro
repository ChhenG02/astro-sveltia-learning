---
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const relatedProjects = allProjects
	.filter((item) => item.data.slug !== data.slug)
	.sort((a, b) => a.data.sortOrder - b.data.sortOrder)
	.slice(0, 2);
---

<MainLayout
	title={`${data.title} | ${SITE_TITLE} Projects`}
	description={data.summary}
	image={data.coverImage}
>
	<article class="detail-page-v2 section-space-top">
		<div class="container">
			<div class="detail-top-bar" data-reveal>
				<a class="back-pill-link" href="/projects/">← Back to all Projects</a>
				<div class="detail-meta-pills">
					<span class="pill-tag pill-tag-dark">{data.category}</span>
					<span class="pill-tag pill-tag-cream">{data.year} · {data.location}</span>
				</div>
			</div>

			<header class="detail-header-v2" data-reveal>
				<h1>{data.title}</h1>
				<p class="detail-lead">{data.summary}</p>
			</header>

			<div class="detail-hero-photo notched-photo-wrap" data-reveal>
				<img
					src={data.coverImage}
					alt={data.coverImageAlt}
					width="1200"
					height="620"
					class="notched-photo-img"
				/>
			</div>

			<div class="project-detail-layout section-space">
				<div class="project-main-col" data-reveal>
					{(data.challenge || data.solution) && (
						<div class="challenge-solution-grid">
							{data.challenge && (
								<div class="cs-card cs-challenge">
									<span class="label-tag">The Challenge</span>
									<p>{data.challenge}</p>
								</div>
							)}
							{data.solution && (
								<div class="cs-card cs-solution">
									<span class="label-tag">Our Engineering Solution</span>
									<p>{data.solution}</p>
								</div>
							)}
						</div>
					)}

					<div class="prose-v2">
						<Content />
					</div>

					{data.results && data.results.length > 0 && (
						<div class="project-results-box">
							<h3>Key Project Outcomes</h3>
							<ul>
								{data.results.map((res) => (
									<li>
										<span class="check-circle" aria-hidden="true">✓</span>
										<span>{res}</span>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>

				<aside class="project-facts-card" data-reveal>
					<h3>Project Facts</h3>
					<dl class="facts-dl">
						{data.client && (
							<div>
								<dt>Client / Facility</dt>
								<dd>{data.client}</dd>
							</div>
						)}
						<div>
							<dt>Category</dt>
							<dd>{data.category}</dd>
						</div>
						<div>
							<dt>Location</dt>
							<dd>{data.location}</dd>
						</div>
						<div>
							<dt>Year</dt>
							<dd>{data.year}</dd>
						</div>
						<div>
							<dt>Engineering Scope</dt>
							<dd>{data.scope}</dd>
						</div>
					</dl>
					<a class="btn-secondary full-width-btn" href="/contact/">
						<span>Plan a Similar Project</span>
						<span class="btn-arrow-circle" aria-hidden="true">↗</span>
					</a>
				</aside>
			</div>

			{data.gallery && data.gallery.length > 1 && (
				<section class="project-gallery-v2 section-space-bottom" data-reveal>
					<h2 class="section-title">Project gallery</h2>
					<div class="gallery-two-col">
						{data.gallery.map((img) => (
							<figure class="gallery-frame">
								<img src={img.src} alt={img.alt} loading="lazy" width="600" height="420" />
								<figcaption>{img.alt}</figcaption>
							</figure>
						))}
					</div>
				</section>
			)}
		</div>
	</article>

	{relatedProjects.length > 0 && (
		<section class="section-space section-offwhite">
			<div class="container">
				<div class="section-header-split" data-reveal>
					<div>
						<span class="label-tag">More Commissioned Work</span>
						<h2 class="section-title">Related projects</h2>
					</div>
					<a class="btn-secondary" href="/projects/">
						<span>All Projects</span>
						<span class="btn-arrow-circle" aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="projects-staggered-grid">
					{relatedProjects.map((rel, idx) => (
						<ProjectCard project={rel} staggerIndex={idx} />
					))}
				</div>
			</div>
		</section>
	)}
</MainLayout>
