---
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = await getCollection('projects', ({ data }) => !data.draft);
const relatedProjects = projects
	.filter((item) => item.data.slug !== project.data.slug)
	.sort((a, b) => a.data.sortOrder - b.data.sortOrder)
	.slice(0, 2);
---

<MainLayout
	title={`${project.data.title} | Northline Engineering`}
	description={project.data.description}
>
	<article>
		<header class="project-detail-header">
			<div class="container">
				<a class="back-link" href="/projects/">← All projects</a>
				<p class="eyebrow">{project.data.category} <span aria-hidden="true">/</span> {project.data.location}</p>
				<h1>{project.data.title}</h1>
				<p class="lead">{project.data.description}</p>
			</div>
		</header>
		<div class="project-cover">
			<img src={project.data.coverImage} alt={project.data.coverImageAlt} width="1800" height="1000" />
		</div>
		<section class="section-space">
			<div class="container project-detail-grid">
				<div class="project-overview">
					<p class="eyebrow">Project overview</p>
					<h2>Designed for reliable day-to-day performance.</h2>
					<Content />
					<p>
						Working closely with the client team, Northline developed an approach that balanced
						operational continuity, safety, and future flexibility. The result is a maintainable
						solution shaped around the people who use it.
					</p>
				</div>
				<dl class="project-facts">
					<div><dt>Location</dt><dd>{project.data.location}</dd></div>
					<div><dt>Category</dt><dd>{project.data.category}</dd></div>
					<div><dt>Year</dt><dd>{project.data.year}</dd></div>
					<div><dt>Scope</dt><dd>{project.data.scope}</dd></div>
				</dl>
			</div>
		</section>
		<section class="project-gallery-section section-space section-muted">
			<div class="container">
				<h2>Inside the project</h2>
				<div class="project-gallery">
					{project.data.gallery.map((image) => (
						<img src={image.src} alt={image.alt} width="1000" height="720" loading="lazy" />
					))}
				</div>
			</div>
		</section>
	</article>

	{relatedProjects.length > 0 && (
		<section class="section-space">
			<div class="container">
				<div class="related-heading">
					<div><p class="eyebrow">More work</p><h2>Related projects</h2></div>
					<a class="text-link" href="/projects/">View all projects <span aria-hidden="true">→</span></a>
				</div>
				<div class="project-grid">
					{relatedProjects.map((relatedProject) => <ProjectCard project={relatedProject} />)}
				</div>
			</div>
		</section>
	)}
	<ContactCTA />
</MainLayout>
