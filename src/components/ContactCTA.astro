---
import { CONTACT_INFO } from '../consts';

export interface Props {
	eyebrow?: string;
	headline?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	floatingLabel?: string;
}

const {
	eyebrow = 'READY WHEN YOUR OPERATION NEEDS US',
	headline = 'Need an automation or electrical engineering partner?',
	description = 'From urgent PLC or breaker troubleshooting to turnkey 5000A switchboards, SAUTER BMS, and robotic welding lines — talk directly with our engineering team.',
	image = '/images/services/service-electrical-power.jpg',
	imageAlt = 'PATech industrial electrical control panel with precision DIN-rail circuit breakers and labeled wiring',
	floatingLabel = 'Industrial Engineering Solutions',
} = Astro.props;
---

<section class="cta-banner-section" aria-label="Call to action">
	<div class="container">
		<div class="cta-banner" data-reveal>
			<!-- Faint circuit-line pattern with dot endpoints inside CTA banner -->
			<svg
				class="circuit-motif cta-circuit-motif"
				viewBox="0 0 1200 420"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path d="M0 64H180L224 108H390" stroke="currentColor" stroke-width="1.25" />
				<circle cx="390" cy="108" r="4" fill="currentColor" />
				<path d="M1200 56H960L912 104H740" stroke="currentColor" stroke-width="1.25" />
				<circle cx="740" cy="104" r="4" fill="currentColor" />
				<path d="M1200 180H1020L980 220H840" stroke="currentColor" stroke-width="1.25" />
				<circle cx="840" cy="220" r="3.5" fill="currentColor" />
				<path d="M620 0V44L656 80H780" stroke="currentColor" stroke-width="1.25" />
				<circle cx="780" cy="80" r="3.5" fill="currentColor" />
				<path d="M460 420V356L504 312H640" stroke="currentColor" stroke-width="1.25" />
				<circle cx="640" cy="312" r="4" fill="currentColor" />
			</svg>

			<div class="cta-watermark" aria-hidden="true">PATech</div>

			<div class="cta-visual-col">
				<div class="cta-visual-frame">
					<img
						src={image}
						alt={imageAlt}
						class="cta-visual-img"
						loading="lazy"
						width="520"
						height="360"
					/>
					<div class="cta-visual-overlay" aria-hidden="true"></div>
					{floatingLabel && (
						<span class="cta-visual-label">
							<span class="cta-visual-dot" aria-hidden="true"></span>
							{floatingLabel}
						</span>
					)}
				</div>
			</div>

			<div class="cta-copy-col">
				<span class="cta-eyebrow">{eyebrow}</span>
				<h2>{headline}</h2>
				<p>{description}</p>
				<div class="cta-actions">
					<a class="cta-phone-pill" href={CONTACT_INFO.phoneHref}>
						<span class="cta-phone-icon" aria-hidden="true">
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
						</span>
						<span class="cta-phone-text">
							<small>Call 24/7 Engineering Desk</small>
							<strong>{CONTACT_INFO.phone}</strong>
						</span>
					</a>

					<a class="btn-secondary" href="/contact/">
						<span>Request a Free Quote</span>
						<span class="btn-arrow-circle" aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
