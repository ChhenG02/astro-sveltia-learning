---
import { getCollection } from 'astro:content';

const partners = (await getCollection('partners')).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder,
);
---

<section class="partners-section">
	<div class="container partners-inner">
		<p class="eyebrow">Integrated across disciplines</p>
		<div class="partner-list" aria-label="Northline's engineering disciplines">
			{partners.map(({ data: partner }) => (
				partner.website ? (
					<a class="partner-wordmark" href={partner.website}>
						{partner.logo ? <img class="partner-logo" src={partner.logo} alt={partner.name} /> : partner.name}
					</a>
				) : (
					<span class="partner-wordmark">
						{partner.logo ? <img class="partner-logo" src={partner.logo} alt={partner.name} /> : partner.name}
					</span>
				)
			))}
		</div>
	</div>
</section>
