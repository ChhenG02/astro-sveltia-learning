---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<header class:list={['section-heading', { 'section-heading-center': align === 'center' }]}>
	<p class="eyebrow">{eyebrow}</p>
	<h2>{title}</h2>
	{description && <p class="section-description">{description}</p>}
</header>
