---
import type { CollectionEntry } from 'astro:content';

interface Props {
	service: CollectionEntry<'services'>['data'];
	detailed?: boolean;
}

const { service, detailed = false } = Astro.props;
---

<article class:list={['service-card', { 'service-card-detailed': detailed }]}>
	<span class="service-number">{service.number}</span>
	<h3>{service.title}</h3>
	<p>{service.summary}</p>
	{detailed && <div class="service-description"><slot /></div>}
	<a class="text-link" href="/services/">Explore this service <span aria-hidden="true">→</span></a>
</article>
