---
import { CONTACT_INFO, SITE_LEGAL_NAME, SITE_TITLE } from '../consts';

const currentYear = new Date().getFullYear();
---

<div class="footer-cta-wrapper">
	<!-- 7. FINAL CTA BANNER (Overlaps top of footer) -->
	<section class="cta-banner-section" aria-label="Call to action">
		<div class="container">
			<div class="cta-banner" data-reveal>
				<!-- Faint circuit-line pattern with dot endpoints inside CTA banner -->
				<svg
					class="circuit-motif cta-circuit-motif"
					viewBox="0 0 1200 420"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path d="M0 64H180L224 108H390" stroke="currentColor" stroke-width="1.25" />
					<circle cx="390" cy="108" r="4" fill="currentColor" />
					<path d="M1200 56H960L912 104H740" stroke="currentColor" stroke-width="1.25" />
					<circle cx="740" cy="104" r="4" fill="currentColor" />
					<path d="M1200 180H1020L980 220H840" stroke="currentColor" stroke-width="1.25" />
					<circle cx="840" cy="220" r="3.5" fill="currentColor" />
					<path d="M620 0V44L656 80H780" stroke="currentColor" stroke-width="1.25" />
					<circle cx="780" cy="80" r="3.5" fill="currentColor" />
					<path d="M460 420V356L504 312H640" stroke="currentColor" stroke-width="1.25" />
					<circle cx="640" cy="312" r="4" fill="currentColor" />
				</svg>

				<div class="cta-watermark" aria-hidden="true">PATech</div>

				<div class="cta-worker-col">
					<div class="cta-worker-frame">
						<img
							src="/images/team/pov-hongly.png"
							alt="PATech Chief Technical Officer and licensed automation engineer"
							class="cta-worker-img"
							loading="lazy"
							width="420"
							height="460"
						/>
						<span class="cta-worker-badge">
							<span class="badge-dot"></span>
							24/7 On-Call Engineering Team
						</span>
					</div>
				</div>

				<div class="cta-copy-col">
					<span class="cta-eyebrow">Ready when your operation needs us</span>
					<h2>Have a job that needs a licensed automation engineer?</h2>
					<p>
						From urgent PLC or breaker troubleshooting to turnkey 5000A switchboards, SAUTER BMS, and robotic welding lines—talk directly with our engineers.
					</p>
					<div class="cta-actions">
						<a class="cta-phone-pill" href={CONTACT_INFO.phoneHref}>
							<span class="cta-phone-icon" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
								</svg>
							</span>
							<span class="cta-phone-text">
								<small>Call 24/7 Engineering Desk</small>
								<strong>{CONTACT_INFO.phone}</strong>
							</span>
						</a>

						<a class="btn-secondary" href="/contact/">
							<span>Request a Free Quote</span>
							<span class="btn-arrow-circle" aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. FOOTER (Deep Navy #0B1B3F with continuing watermark & circuit-trace motif) -->
	<footer class="site-footer">
		<svg
			class="circuit-motif footer-circuit-motif"
			viewBox="0 0 1440 480"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path d="M0 180H190L238 228H410" stroke="currentColor" stroke-width="1.25" />
			<circle cx="410" cy="228" r="4" fill="currentColor" />
			<path d="M0 320H120L164 276H290" stroke="currentColor" stroke-width="1.25" />
			<circle cx="290" cy="276" r="3.5" fill="currentColor" />
			<path d="M1440 240H1210L1162 288H990" stroke="currentColor" stroke-width="1.25" />
			<circle cx="990" cy="288" r="4" fill="currentColor" />
			<path d="M1440 370H1270L1230 330H1100" stroke="currentColor" stroke-width="1.25" />
			<circle cx="1100" cy="330" r="3.5" fill="currentColor" />
		</svg>

		<div class="footer-watermark-continuation" aria-hidden="true">PATech</div>

		<div class="container footer-main">
			<div class="footer-brand">
				<a class="brand brand-light" href="/" aria-label={`${SITE_TITLE} home`}>
					<img
						src="/images/brand/patech-logo-white.png"
						alt="PATech – Pisnuk AutoTech"
						class="brand-logo"
						width="156"
						height="42"
					/>
				</a>
				<p class="footer-desc">
					Building and factory automation solutions with premium electrical panels for safer, smarter operations in Cambodia. Registered with the Ministry of Commerce since 2018.
				</p>
				<div class="footer-socials" aria-label="Social media">
					<a href="https://www.facebook.com/PisnukAutoTech/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
						</svg>
					</a>
					<a href={CONTACT_INFO.telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M21.9 4.4 2.9 11.7c-1.3.5-1.3 1.2-.2 1.6l4.9 1.5 11.3-7.1c.5-.3 1-.1.6.2l-9.2 8.3-.3 4.8c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9L23.4 5.7c.3-1.3-.5-1.9-1.5-1.3z"></path>
						</svg>
					</a>
					<a href="https://www.tiktok.com/@patech.official?lang=en" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"></path>
						</svg>
					</a>
				</div>
			</div>

			<div class="footer-links-col">
				<p class="footer-label">Company</p>
				<a href="/about/">About Story</a>
				<a href="/projects/">Projects Portfolio</a>
				<a href="/news-media/">News &amp; Media</a>
				<a href="/#faqs">FAQ's</a>
				<a href="/contact/">Contact &amp; Quote</a>
				<a href="/admin/">Content Manager (CMS)</a>
			</div>

			<div class="footer-links-col">
				<p class="footer-label">Services</p>
				<a href="/services/#factory-automation">Factory Automation (FA)</a>
				<a href="/services/#building-automation">Building Automation (BAS/BMS)</a>
				<a href="/services/#electrical-power-solutions">Electrical Power Panels</a>
				<a href="/services/">SCADA &amp; PLC Programming</a>
				<a href="/services/">Industrial Robotics &amp; Laser</a>
				<a href="/services/">SAUTER Controls Cambodia</a>
			</div>
		</div>

		<div class="container footer-bottom">
			<span>© {currentYear} {SITE_LEGAL_NAME} All rights reserved.</span>
			<span>{CONTACT_INFO.address}</span>
		</div>
	</footer>
</div>
