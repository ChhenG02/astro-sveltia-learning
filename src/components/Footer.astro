---
import { CONTACT_INFO, SITE_LEGAL_NAME, SITE_TITLE } from '../consts';
import ContactCTA from './ContactCTA.astro';

export interface Props {
	ctaEyebrow?: string;
	ctaHeadline?: string;
	ctaDescription?: string;
	hideCta?: boolean;
}

const { ctaEyebrow, ctaHeadline, ctaDescription, hideCta } = Astro.props;
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideCtaBanner =
	hideCta ?? (pathname === '/contact' || pathname.startsWith('/news-media/'));
---

<div class="footer-cta-wrapper">
	<!-- 7. FINAL CTA BANNER (Overlaps top of footer, hidden on Contact and News & Media detail pages) -->
	{!hideCtaBanner && (
		<ContactCTA
			eyebrow={ctaEyebrow}
			headline={ctaHeadline}
			description={ctaDescription}
		/>
	)}

	<!-- 8. FOOTER (Deep Navy #0B1B3F with continuing watermark & circuit-trace motif) -->
	<footer class:list={['site-footer', { 'no-cta-overlap': hideCtaBanner }]}>
		<svg
			class="circuit-motif footer-circuit-motif"
			viewBox="0 0 1440 480"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<path d="M0 180H190L238 228H410" stroke="currentColor" stroke-width="1.25" />
			<circle cx="410" cy="228" r="4" fill="currentColor" />
			<path d="M0 320H120L164 276H290" stroke="currentColor" stroke-width="1.25" />
			<circle cx="290" cy="276" r="3.5" fill="currentColor" />
			<path d="M1440 240H1210L1162 288H990" stroke="currentColor" stroke-width="1.25" />
			<circle cx="990" cy="288" r="4" fill="currentColor" />
			<path d="M1440 370H1270L1230 330H1100" stroke="currentColor" stroke-width="1.25" />
			<circle cx="1100" cy="330" r="3.5" fill="currentColor" />
		</svg>

		<div class="footer-watermark-continuation" aria-hidden="true">PATech</div>

		<div class="container footer-main">
			<div class="footer-brand">
				<a class="brand brand-light" href="/" aria-label={`${SITE_TITLE} home`}>
					<img
						src="/images/brand/patech-logo-white.png"
						alt="PATech – Pisnuk AutoTech"
						class="brand-logo"
						width="156"
						height="42"
					/>
				</a>
				<p class="footer-desc">
					Building and factory automation solutions with premium electrical panels for safer, smarter operations in Cambodia. Registered with the Ministry of Commerce since 2018.
				</p>
				<div class="footer-socials" aria-label="Social media">
					<a href="https://www.facebook.com/PisnukAutoTech/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
						</svg>
					</a>
					<a href={CONTACT_INFO.telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M21.9 4.4 2.9 11.7c-1.3.5-1.3 1.2-.2 1.6l4.9 1.5 11.3-7.1c.5-.3 1-.1.6.2l-9.2 8.3-.3 4.8c.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9L23.4 5.7c.3-1.3-.5-1.9-1.5-1.3z"></path>
						</svg>
					</a>
					<a href="https://www.tiktok.com/@patech.official?lang=en" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-circle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"></path>
						</svg>
					</a>
				</div>
			</div>

			<div class="footer-links-col">
				<p class="footer-label">Company</p>
				<a href="/about/">About Story</a>
				<a href="/projects/">Projects Portfolio</a>
				<a href="/news-media/">News &amp; Media</a>
				<a href="/#faqs">FAQ's</a>
				<a href="/contact/">Contact &amp; Quote</a>
				<a href="/admin/">Content Manager (CMS)</a>
			</div>

			<div class="footer-links-col">
				<p class="footer-label">Services</p>
				<a href="/services/factory-automation/">Factory Automation (FA)</a>
				<a href="/services/building-automation/">Building Automation (BAS/BMS)</a>
				<a href="/services/electrical-power-solutions/">Electrical Power Panels</a>
				<a href="/services/factory-automation/#solutions">SCADA &amp; PLC Programming</a>
				<a href="/services/factory-automation/#solutions">Industrial Robotics &amp; Laser</a>
				<a href="/services/building-automation/#solutions">SAUTER Controls Cambodia</a>
			</div>
		</div>

		<div class="container footer-bottom">
			<span>© {currentYear} {SITE_LEGAL_NAME} All rights reserved.</span>
			<span>{CONTACT_INFO.address}</span>
		</div>
	</footer>
</div>
